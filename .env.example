DATABASE_URL=postgresql://user:password@localhost:5432/woodcastle_db
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_TEMP_TOKEN_EXPIRES_IN=5m

# OTP provider — set OTP_PROVIDER to "dev" | "twilio" | "firebase"
OTP_PROVIDER=dev

# Firebase Phone Auth (optional)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Twilio Verify (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# WhatsApp — set WHATSAPP_PROVIDER to "meta" | "twilio" | "stub"
WHATSAPP_PROVIDER=stub
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ADMIN_NUMBER=

# Media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PORT=5000
NODE_ENV=development
