DATABASE_URL=postgresql://user:password@localhost:5432/woodcastle_db
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_TEMP_TOKEN_EXPIRES_IN=5m

# WhatsApp click-to-chat (no API keys needed — just the admin's number, digits only, with country code)
WHATSAPP_ADMIN_NUMBER=

# Media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Reviews (read-only display, section 5d)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

PORT=5000
NODE_ENV=development

# Admin seed — never commit the real password. Required for prisma db seed.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@woodcastle.local
# Set to true only when you intentionally want seed to overwrite the existing hash.
SEED_ADMIN_RESET=false
